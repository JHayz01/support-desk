<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>CristalixSupport</AssemblyName>
    <Version>8.5.3</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SupportDesk.Core/SupportDesk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="connection.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="connection.json" LogicalName="SupportDesk.Connection" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/app.png" />
    <EmbeddedResource Include="Assets/app.ico" LogicalName="SupportDesk.Icon" />
    <None Update="release.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="release.json" LogicalName="SupportDesk.Release" />
  </ItemGroup>
</Project>
