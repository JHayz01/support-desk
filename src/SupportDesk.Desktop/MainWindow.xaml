<Window x:Class="SupportDesk.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SupportDesk.Desktop" Title="Cristalix Support" Icon="Assets/app.png" Width="1100" Height="800" MinWidth="620" MinHeight="460" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" ShowInTaskbar="True" Background="{DynamicResource C151720}" Foreground="{DynamicResource CE9EAF0}" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="WindowKeyDown">

 <Window.Resources>
  <Style TargetType="ToolTip"><Setter Property="MaxWidth" Value="390"/><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></Setter.Value></Setter></Style>
  <Style x:Key="OptionalLabel" TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style><BooleanToVisibilityConverter x:Key="Visible"/><local:CommandLabelConverter x:Key="CommandLabel"/>
  
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource C2A2E40}"/><Setter Property="Foreground" Value="{DynamicResource CEBECF5}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource C41465E}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource C222637}"/><Setter Property="Foreground" Value="{DynamicResource CEAEBF3}"/><Setter Property="CaretBrush" Value="{DynamicResource CEAEBF3}"/><Setter Property="BorderBrush" Value="{DynamicResource C3D435A}"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="3"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource C222637}"/><Setter Property="Foreground" Value="{DynamicResource CEAEBF3}"/><Setter Property="BorderBrush" Value="{DynamicResource C3D435A}"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="3,10"/></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="ToolTip" Value="{Binding}"/><Setter Property="Foreground" Value="{DynamicResource CE8EAF3}"/><Setter Property="Padding" Value="10,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource C41465E}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource C51466E}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="ToolTip" Value="{Binding SelectedItem,RelativeSource={RelativeSource Self}}"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="95"/><Setter Property="Foreground" Value="{DynamicResource CE8EAF3}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource C252A3B}" CornerRadius="7" BorderBrush="{DynamicResource C3A4057}" BorderThickness="1"><TextBlock Text="⌄" Foreground="{DynamicResource CADB3CA}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter x:Name="SelectionLabel" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,9,26,9" VerticalAlignment="Center"/><TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Background="Transparent" Foreground="{TemplateBinding Foreground}" BorderThickness="0" Padding="0" Margin="10,9,27,9" Style="{x:Null}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource C252A3B}" BorderBrush="{DynamicResource C4A526D}" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionLabel" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource CCCD0E2}"/><Setter Property="Margin" Value="5,10"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="{DynamicResource C212535}" CornerRadius="9" Padding="14" BorderBrush="{DynamicResource C30364C}" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource C2B3044}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource C34304B}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CA397EC}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <DockPanel Margin="2,0,2,10" LastChildFill="True">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="UpdatesButton" Content="Обновления" Click="UpdatesClick" ToolTip="Проверить и установить новую версию"/>
    <Button x:Name="PinButton" FontFamily="Segoe MDL2 Assets" Content="&#xE718;" Click="PinClick" ToolTip="Закрепить поверх других окон" AutomationProperties.Name="Закрепить окно"/>
    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE713;" Click="SettingsClick" ToolTip="Настройки" AutomationProperties.Name="Настройки"/>
    <Button FontFamily="Segoe MDL2 Assets" Content="&#xE8F1;" Click="CommandsClick" ToolTip="Список команд вставки" AutomationProperties.Name="Список команд"/>
   </StackPanel>
   <TextBlock Text="База ответов" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid x:Name="Body" Grid.Row="1" Visibility="{Binding Unlocked,Converter={StaticResource Visible}}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Text="{Binding Query,UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск по ответам, командам вставки и кодам ошибок · Ctrl+F" FontSize="15" Padding="10,10,38,10"/><TextBlock Text="Поиск ответов" Foreground="{DynamicResource C9DA3B9}" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="0" Content="×" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="0" Background="Transparent" Foreground="{DynamicResource C9DA3B9}" ToolTip="Очистить поисковый запрос" AutomationProperties.Name="Очистить поиск" Click="ClearClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Grid.Column="1" Content="По смыслу" Click="SemanticClick" ToolTip="Найти похожие проблемы по смыслу с помощью модели на сервере. Параметры совпадения слов на этот поиск не влияют · Ctrl+Shift+Enter" Background="{DynamicResource C63549B}" Foreground="White"/></Grid>
   <Grid Grid.Row="1" Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
    <StackPanel ToolTip="Ограничивает список и поиск выбранной категорией. Переключатель ниже позволяет искать по всем категориям."><TextBlock Text="Категория ответов" Margin="5,3" Foreground="{DynamicResource C9DA3B9}"/><local:CategorySearchBox x:Name="CategoryBox" Style="{StaticResource {x:Type ComboBox}}" ToolTip="{Binding Category, StringFormat=Выбрана категория: {0}. Начните вводить название для фильтрации.}"/></StackPanel>
    <StackPanel Grid.Column="1" ToolTip="Оставить ответы для Windows, Linux, macOS или всех систем."><TextBlock Text="Система" Margin="5,3" Foreground="{DynamicResource C9DA3B9}"/><ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}"/></StackPanel>
    <StackPanel Grid.Column="2" ToolTip="Показать все ответы, только избранные или недавно использованные."><TextBlock Text="Показать ответы" Margin="5,3" Foreground="{DynamicResource C9DA3B9}"/><ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/></StackPanel>
   </Grid>
   <Expander Grid.Row="2" Header="Параметры поиска" Margin="5,8" Foreground="{DynamicResource C9DA3B9}" ToolTip="Точность совпадения и поиск только по заголовкам, тексту или командам вставки">   <Grid  Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel ToolTip="Все слова: каждое слово в любом порядке, допускается начало слова. Любое слово: достаточно одного. Слова подряд: точная фраза. Целые слова: каждое слово без совпадений по началу. Эти параметры относятся к обычному поиску."><TextBlock Text="Как совпадает запрос" Margin="5,3" Foreground="{DynamicResource C9DA3B9}"/><ComboBox ItemsSource="{Binding SearchMatches}" SelectedIndex="{Binding SearchMatchIndex}"/></StackPanel>
    <StackPanel Grid.Column="1" ToolTip="Вся запись: заголовок, варианты ответа, категория, заметки и команды вставки. Можно выбрать поиск только по командам."><TextBlock Text="Где искать текст" Margin="5,3" Foreground="{DynamicResource C9DA3B9}"/><ComboBox ItemsSource="{Binding SearchScopes}" SelectedIndex="{Binding SearchScopeIndex}"/></StackPanel>
   </Grid></Expander>
   <Grid Grid.Row="3" Margin="3,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <CheckBox Content="При поиске игнорировать выбранную категорию" IsChecked="{Binding SearchEverywhere}" ToolTip="Включено: запрос ищет по всем категориям. Выключено: только в категории, выбранной выше. Остальные фильтры продолжают действовать. Без запроса отображается выбранная категория." Margin="3,4"/>
    <DockPanel Grid.Row="1"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Новый ответ" Click="NewClick" ToolTip="Добавить ответ в общую базу · Ctrl+N"/><Button Content="Синхронизировать" Click="SyncClick" ToolTip="Получить последние изменения из общей базы"/></StackPanel><TextBlock Text="{Binding ResultCount}" Foreground="{DynamicResource C9DA3B9}" VerticalAlignment="Center"/></DockPanel>
   </Grid>
   <Grid Grid.Row="4" x:Name="Workspace"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SplitterColumn" Width="8"/><ColumnDefinition x:Name="DetailColumn" Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="ResultList" Grid.Column="0" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" SelectionChanged="SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CE9EAF0}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock ToolTip="{Binding Title}" local:SearchHighlight.Text="{Binding Title}" local:SearchHighlight.Query="{Binding DataContext.Query,RelativeSource={RelativeSource AncestorType=Window}}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock local:SearchHighlight.Text="{Binding Preview}" local:SearchHighlight.Query="{Binding DataContext.Query,RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource CACB2C7}" Margin="0,7,0,8" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal"><TextBlock ToolTip="{Binding Category}" Text="{Binding Category}" Foreground="{DynamicResource CA99CDA}"/><TextBlock Text=" · " Foreground="{DynamicResource C707890}"/><TextBlock Text="{Binding Platform}" Foreground="{DynamicResource C959DB4}"/></StackPanel><TextBlock Style="{StaticResource OptionalLabel}" Foreground="{DynamicResource CA99CDA}" TextWrapping="Wrap" Margin="0,6,0,0" ToolTip="Команда вставки: введите ее в чате и нажмите пробел"><TextBlock.Text><MultiBinding Converter="{StaticResource CommandLabel}"><Binding Path="Id"/><Binding Path="DataContext.CommandLabels" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border x:Name="DetailPane" Grid.Column="2" Background="{DynamicResource C1D2130}" CornerRadius="9" Padding="12" Margin="0" Visibility="{Binding Detail,Converter={StaticResource Visible}}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="CloseDetailClick"/><TextBlock Text="{Binding Selected.Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Style="{StaticResource OptionalLabel}" Text="{Binding SelectedCommand}" ToolTip="Команда вставки: введите ее в чате и нажмите пробел" Foreground="{DynamicResource CA99CDA}" TextWrapping="Wrap" Margin="5,10"/><DockPanel Grid.Row="1" Visibility="{Binding HasMultipleResponses,Converter={StaticResource Visible}}"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="←" Click="PreviousResponseClick" ToolTip="Предыдущий ответ / шаг"/><Button Content="→" Click="NextResponseClick" ToolTip="Следующий ответ / шаг"/></StackPanel><ComboBox ItemsSource="{Binding ResponseOptions}" SelectedItem="{Binding SelectedResponse}" DisplayMemberPath="DisplayTitle" ToolTip="Выберите вариант ответа или шаг. Копируется только выбранный текст."/></DockPanel><TextBlock Style="{StaticResource OptionalLabel}" Grid.Row="2" Text="{Binding ResponseHint}" Foreground="{DynamicResource C9DA3B9}" TextWrapping="Wrap" Margin="5"/><TextBox Grid.Row="3" Text="{Binding ResponseBody,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="60" Background="Transparent" BorderThickness="0"/></Grid><WrapPanel Grid.Row="2"><Button Content="Скопировать · Ctrl+Enter" Background="{DynamicResource C63549B}" Foreground="White" Click="CopyClick"/><Button Content="{Binding FavoriteLabel}" Click="FavoriteClick"/><Button Content="Изменить" Click="EditClick"/><Button Content="Назначить команду" Click="BindClick"/></WrapPanel></Grid></Border>
    <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource C30364C}" ResizeBehavior="PreviousAndNext"/>
   </Grid>
  </Grid>
  <Grid Grid.Row="1" Visibility="{Binding Gated,Converter={StaticResource Visible}}"><StackPanel Width="390" VerticalAlignment="Center"><TextBlock Text="{Binding GateTitle}" FontSize="25" FontWeight="SemiBold" Margin="3,0,0,10"/><TextBlock Text="{Binding GateHint}" Foreground="{DynamicResource C9DA3B9}" TextWrapping="Wrap"/><PasswordBox x:Name="GatePassword" KeyDown="PasswordKeyDown" Visibility="{Binding NeedsPassword,Converter={StaticResource Visible}}"/><CheckBox x:Name="RememberBox" Visibility="{Binding SupportLogin,Converter={StaticResource Visible}}" Content="Запомнить вход на этом компьютере" IsChecked="True"/><Button x:Name="OpenButton" Content="{Binding OpenLabel}" Background="{DynamicResource C63549B}" Foreground="White" Click="OpenClick"/><Button Content="Выйти из базы / сменить подключение" Click="LogoutClick"/></StackPanel></Grid>
  <TextBlock Grid.Row="2" ToolTip="{Binding Status}" Text="{Binding Status}" Foreground="{DynamicResource C9DA3B9}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,5,0,0"/>
 </Grid>
</Window>
